{
  "imports": {
    "fullsoak": "jsr:@fullsoak/fullsoak@0.18.1-alpha.3",
    // "fullsoak": "../../fullsoak/mod.ts", // enable for local fullsoak development
    // "fullsoak/batteries": "../../fullsoak/mod-batteries.ts", // enable for local fullsoak development
    // "fullsoak/testing": "../../fullsoak/mod-testing.ts", // enable for local fullsoak development
    "preact": "npm:preact@10.26.5",
    "preact-iso": "npm:preact-iso@2.9.1",
    "@std/testing": "jsr:@std/testing@^1.0.11",
    "superoak": "https://deno.land/x/superoak@4.8.1/mod.ts",
    "react": "npm:preact@10.26.5/compat",
    "react-dom": "npm:preact@10.26.5/compat/",
    "@shoelace-style/shoelace": "npm:@shoelace-style/shoelace@2.20.1",
    "lucide-react": "npm:lucide-react@^0.503.0",
    "class-variance-authority": "npm:class-variance-authority@^0.7.1",
    "clsx": "npm:clsx@^2.1.1",
    "tailwind-merge": "npm:tailwind-merge@^3.2.0",
    "tailwindcss": "npm:tailwindcss@^4.1.4",
    "tw-animate-css": "npm:tw-animate-css@^1.2.8",
    "@/lib/": "./lib/"
  },
  // "patch": ["../../fullsoak/"], // enable for local fullsoak development
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "precompile", // see https://docs.deno.com/runtime/reference/jsx/#jsx-precompile-transform
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": ["a", "link"],
    "experimentalDecorators": false // https://deno.com/deploy/changelog#es-decorators-are-enabled-on-deno-deploy-replacing-experimental-ts-decorators
  },
  "tasks": {
    "dev": "deno -A --watch src/main.ts",
    "test": "deno test -NIER --allow-ffi --allow-run --no-check",
    "test-update": "deno task test -W -- --update",
    "compile": "deno compile --no-check --output=dist/main -NER --allow-ffi src/main.ts"
  }
}
